{
  "name": "@grantjs/telemetry",
  "version": "1.0.0",
  "private": true,
  "description": "Telemetry adapters for Grant (log shipping: noop, CloudWatch)",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src/**/*"
  ],
  "scripts": {
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@grantjs/core": "workspace:*"
  },
  "peerDependencies": {
    "@aws-sdk/client-cloudwatch-logs": "^3",
    "typescript": "^6.0.2"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-cloudwatch-logs": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aws-sdk/client-cloudwatch-logs": "^3.1127.0",
    "@types/node": "^26.4.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.11"
  },
  "license": "MIT"
}
