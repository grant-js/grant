{
  "name": "@grantjs/cache",
  "version": "1.0.0",
  "private": true,
  "description": "Cache adapters for Grant (memory, Redis, DynamoDB)",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./memory": {
      "types": "./src/memory/index.ts",
      "default": "./src/memory/index.ts"
    },
    "./redis": {
      "types": "./src/redis/index.ts",
      "default": "./src/redis/index.ts"
    },
    "./dynamodb": {
      "types": "./src/dynamodb/index.ts",
      "default": "./src/dynamodb/index.ts"
    }
  },
  "files": [
    "src/**/*"
  ],
  "scripts": {
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.config.integration.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@grantjs/core": "workspace:*"
  },
  "peerDependencies": {
    "ioredis": "^6",
    "typescript": "^6.0.2",
    "@aws-sdk/client-dynamodb": "^3"
  },
  "peerDependenciesMeta": {
    "ioredis": {
      "optional": true
    },
    "@aws-sdk/client-dynamodb": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.1134.0",
    "@types/node": "^26.6.1",
    "ioredis": "^6.0.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.1"
  },
  "license": "MIT"
}
