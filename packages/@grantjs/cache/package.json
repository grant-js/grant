{
  "name": "@grantjs/cache",
  "version": "1.0.0",
  "private": true,
  "description": "Cache adapters for Grant (memory, Redis)",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./memory": {
      "types": "./src/memory/index.ts",
      "default": "./src/memory/index.ts"
    },
    "./redis": {
      "types": "./src/redis/index.ts",
      "default": "./src/redis/index.ts"
    }
  },
  "files": [
    "src/**/*"
  ],
  "scripts": {
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@grantjs/core": "workspace:*"
  },
  "peerDependencies": {
    "ioredis": "^5",
    "typescript": "^6.0.3"
  },
  "peerDependenciesMeta": {
    "ioredis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "ioredis": "^5.11.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "license": "MIT"
}
