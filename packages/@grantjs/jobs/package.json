{
  "name": "@grantjs/jobs",
  "version": "1.0.0",
  "private": true,
  "description": "Job scheduling adapters for Grant (node-cron, BullMQ, AWS)",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./node-cron": {
      "types": "./src/node-cron/index.ts",
      "default": "./src/node-cron/index.ts"
    },
    "./bullmq": {
      "types": "./src/bullmq/index.ts",
      "default": "./src/bullmq/index.ts"
    },
    "./aws": {
      "types": "./src/aws/index.ts",
      "default": "./src/aws/index.ts"
    }
  },
  "files": [
    "src/**/*"
  ],
  "scripts": {
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.config.integration.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@grantjs/core": "workspace:*",
    "@grantjs/schema": "workspace:*"
  },
  "peerDependencies": {
    "node-cron": "^3",
    "bullmq": "^5",
    "typescript": "^6.0.2",
    "@aws-sdk/client-sqs": "^3"
  },
  "peerDependenciesMeta": {
    "node-cron": {
      "optional": true
    },
    "bullmq": {
      "optional": true
    },
    "@aws-sdk/client-sqs": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aws-sdk/client-sqs": "^3.1127.0",
    "@types/node": "^26.4.1",
    "@types/node-cron": "^3.0.11",
    "bullmq": "^5.81.3",
    "node-cron": "^4.6.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.10"
  },
  "license": "MIT"
}
