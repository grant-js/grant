{
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "declaration": true,
    "declarationMap": true,
    "jsx": "react-jsx",
    "types": ["react", "node"],
    // Neutralises the root tsconfig's `@grantjs/*` -> ./packages/@grantjs/* mapping.
    // A child `paths` REPLACES the inherited one, so this must be an explicit empty
    // object: deleting the key entirely re-inherits the root mapping, which resolves
    // @grantjs/schema to its .ts source and fails with TS6059 (source outside this
    // package's inferred rootDir). Empty means "no mapping" -> normal node resolution
    // through the workspace symlink, which is what actually works here.
    "paths": {}
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.test.tsx"]
}
