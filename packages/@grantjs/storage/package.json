{
  "name": "@grantjs/storage",
  "version": "1.0.0",
  "private": true,
  "description": "File storage adapters for Grant (local, S3)",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./local": {
      "types": "./src/local/index.ts",
      "default": "./src/local/index.ts"
    },
    "./s3": {
      "types": "./src/s3/index.ts",
      "default": "./src/s3/index.ts"
    }
  },
  "files": [
    "src/**/*"
  ],
  "scripts": {
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.config.integration.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@grantjs/core": "workspace:*"
  },
  "peerDependencies": {
    "@aws-sdk/client-s3": "^3",
    "@aws-sdk/s3-request-presigner": "^3",
    "typescript": "^6.0.3"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-s3": {
      "optional": true
    },
    "@aws-sdk/s3-request-presigner": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1113.0",
    "@aws-sdk/s3-request-presigner": "^3.1113.0",
    "@types/node": "^26.2.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "license": "MIT"
}
