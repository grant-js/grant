{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "declaration": false
  },
  "include": ["src/**/*"],
  // A child `exclude` REPLACES the inherited one rather than merging, so every
  // pattern this build needs is restated here in full. src/test-support/ is the
  // addition: it holds plain modules the tests import, which the *.test.ts
  // pattern does not catch, and which were shipping into the production API
  // image. Read by scripts/docker/build-api-production.mjs, not by `pnpm build`.
  "exclude": [
    "node_modules",
    "dist",
    "src/seed/**/*",
    "src/scripts/**/*",
    "**/*.test.ts",
    "**/*.spec.ts",
    "src/test-support/**"
  ]
}
