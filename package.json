{
  "name": "grant",
  "version": "1.5.3",
  "private": true,
  "type": "module",
  "author": {
    "name": "Ale Heredia",
    "email": "ale@grantjs.org",
    "url": "https://grantjs.org"
  },
  "description": "Multi-tenant RBAC platform with monorepo architecture",
  "scripts": {
    "env:setup": "node scripts/env/setup.mjs",
    "predev": "pnpm env:setup",
    "build": "turbo run build",
    "build:release": "turbo run build --filter=@grantjs/client... --filter=@grantjs/server... --filter=@grantjs/cli...",
    "dev": "turbo run dev",
    "config": "pnpm --filter grant-config dev",
    "lint": "turbo lint",
    "dead-code": "knip",
    "dead-code:api": "knip --workspace apps/api",
    "dead-code:web": "knip --workspace apps/web",
    "dead-code:core": "knip --workspace packages/@grantjs/core",
    "dead-code:database": "knip --workspace packages/@grantjs/database",
    "dead-code:schema": "knip --workspace packages/@grantjs/schema",
    "dead-code:published": "knip --workspace packages/@grantjs/client --workspace packages/@grantjs/server --workspace packages/@grantjs/cli",
    "dead-code:packages": "knip --workspace packages/@grantjs/analytics --workspace packages/@grantjs/cache --workspace packages/@grantjs/constants --workspace packages/@grantjs/email --workspace packages/@grantjs/env --workspace packages/@grantjs/errors --workspace packages/@grantjs/i18n --workspace packages/@grantjs/jobs --workspace packages/@grantjs/logger --workspace packages/@grantjs/storage --workspace packages/@grantjs/telemetry --workspace packages/@grantjs/webhooks",
    "codegen:check": "pnpm --filter @grantjs/schema generate && git diff --exit-code -- packages/@grantjs/schema/src/generated",
    "lint:fix": "turbo lint:fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,graphql}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,graphql}\" --ignore-path .gitignore",
    "format:apps": "prettier --write \"apps/**/*.{ts,tsx,js,jsx,json,md,graphql}\"",
    "format:packages": "prettier --write \"packages/**/*.{ts,tsx,js,jsx,json,md,graphql}\"",
    "test": "turbo test",
    "test:ui": "turbo test:ui",
    "test:coverage": "turbo test:coverage",
    "test:e2e": "./scripts/e2e.sh",
    "test:e2e:up": "./scripts/e2e.sh --up",
    "test:e2e:down": "./scripts/e2e.sh --down",
    "test:e2e:run": "./scripts/e2e.sh --test",
    "test:e2e:report": "./scripts/e2e.sh --report",
    "compliance:report": "./scripts/e2e.sh --report",
    "clean": "turbo clean",
    "type-check": "turbo type-check",
    "check:palette": "pnpm --filter @grantjs/constants run check:palette",
    "generate": "pnpm --filter @grantjs/schema generate",
    "generate:watch": "pnpm --filter @grantjs/schema generate:watch",
    "db:generate": "pnpm --filter @grantjs/database db:generate",
    "db:migrate": "pnpm --filter @grantjs/database db:migrate",
    "db:seed": "pnpm --filter @grantjs/database db:seed",
    "db:seed:permissions": "pnpm --filter @grantjs/database db:seed:permissions",
    "db:seed:system-user": "pnpm --filter @grantjs/database db:seed:system-user",
    "db:reset": "pnpm --filter @grantjs/database db:reset",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "audit": "./scripts/audit-security.sh",
    "audit:quick": "./scripts/audit-quick.sh",
    "webhook:listen": "node scripts/webhook-receiver.mjs",
    "secret-scan": "gitleaks detect --config .gitleaks.toml -v",
    "secret-scan:protect": "GITLEAKS_CONFIG=.gitleaks.toml gitleaks protect -v",
    "audit:fix": "./scripts/audit-fix.sh",
    "audit:pnpm": "pnpm audit --recursive",
    "benchmark:rbac": "node scripts/benchmarks/permission-evaluation.mjs",
    "changeset": "changeset",
    "version": "changeset version && node scripts/update-root-changelog.mjs",
    "release": "pnpm build:release && changeset publish",
    "release:check": "node scripts/check-publishable-packages.mjs",
    "postinstall": "pnpm env:setup --quiet",
    "benchmark:authz": "node scripts/benchmarks/permission-evaluation.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@iconify-json/fluent": "^1.2.53",
    "@iconify-json/fluent-color": "^1.2.21",
    "@types/node": "^26.1.1",
    "badge-maker": "^6.0.0",
    "concurrently": "^10.0.3",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unused-imports": "^4.2.0",
    "graphql": "^16.14.2",
    "knip": "^6.32.0",
    "lint-staged": "^17.1.0",
    "prettier": "^3.9.5",
    "tsx": "^4.23.1",
    "turbo": "^2.10.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vitepress": "^1.6.4"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0",
  "pnpm": {
    "overrides": {
      "fast-xml-parser": "^5.5.6",
      "path-to-regexp": "8.4.0",
      "picomatch": "4.0.4",
      "brace-expansion@1": "1.1.18",
      "brace-expansion@5": "5.0.9",
      "@isaacs/brace-expansion": "5.0.9",
      "yaml": "^2.8.3",
      "@angular-devkit/core>ajv": "^8.18.0",
      "esbuild": "^0.25.0",
      "multer": "2.2.0",
      "rollup": "4.59.0",
      "serialize-javascript": "7.0.3",
      "immutable": "4.3.9",
      "axios": "1.19.0",
      "follow-redirects": "^1.16.0",
      "html-minifier": "npm:html-minifier-terser@7.2.0",
      "lodash": "4.18.1",
      "lodash-es": "4.18.1",
      "minimatch@3.1.2": "3.1.4",
      "minimatch@9.0.1": "9.0.7",
      "minimatch@9.0.5": "9.0.7",
      "minimatch@10.0.3": "10.2.3",
      "minimatch@10.1.2": "10.2.3",
      "fast-uri@3": "3.1.5",
      "find-my-way": "9.7.0",
      "shell-quote": "1.10.0",
      "qs": "6.15.3",
      "body-parser": "2.3.0",
      "@babel/core": "7.29.7",
      "undici@6": "6.28.0",
      "undici@7": "7.29.0",
      "postcss": "8.5.25",
      "svelte": "5.56.8",
      "devalue": "5.9.0",
      "react": "19.2.6",
      "react-dom": "19.2.6",
      "graphql": "16.14.2",
      "typescript": "6.0.3",
      "dompurify": "3.4.13",
      "nanoid": "3.3.17",
      "js-yaml@3": "3.15.1",
      "js-yaml@4": "4.3.1",
      "protobufjs": "7.6.5",
      "svgo": "4.0.2",
      "sharp": "0.35.3",
      "uuid@8": "11.1.1",
      "vite@5": "6.4.3"
    }
  },
  "lint-staged": {
    "apps/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "packages/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,jsx,json,md,graphql,yml,yaml}": [
      "prettier --write"
    ]
  }
}
