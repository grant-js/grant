{
  "name": "grant-api",
  "version": "1.6.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --include .env --include .env.development --include ../../.env --include ../../.env.development src/server.ts",
    "build": "tsc",
    "build:production": "node ../../scripts/docker/build-api-production.mjs",
    "start": "node dist/server.js",
    "migrate": "node dist/migrate.js",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.config.e2e.ts",
    "test:e2e:report": "vitest run --config vitest.config.e2e.ts --reporter=json --reporter=verbose --outputFile=tests/e2e/compliance-report.json",
    "measure:cdm-gzip": "tsx tests/tools/measure-cdm-gzip.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@aws-sdk/client-dynamodb": "^3.1113.0",
    "@aws-sdk/client-s3": "^3.1113.0",
    "@aws-sdk/client-secrets-manager": "^3.1113.0",
    "@aws-sdk/client-ses": "^3.1113.0",
    "@aws-sdk/client-sqs": "^3.1113.0",
    "@aws-sdk/s3-request-presigner": "^3.1113.0",
    "@grantjs/analytics": "workspace:*",
    "@grantjs/cache": "workspace:*",
    "@grantjs/constants": "workspace:*",
    "@grantjs/core": "workspace:*",
    "@grantjs/database": "workspace:*",
    "@grantjs/email": "workspace:*",
    "@grantjs/env": "workspace:*",
    "@grantjs/errors": "workspace:*",
    "@grantjs/i18n": "workspace:*",
    "@grantjs/jobs": "workspace:*",
    "@grantjs/logger": "workspace:*",
    "@grantjs/schema": "workspace:*",
    "@grantjs/secrets": "workspace:*",
    "@grantjs/storage": "workspace:*",
    "@grantjs/telemetry": "workspace:*",
    "@grantjs/webhooks": "workspace:*",
    "@graphql-tools/load-files": "^7.0.1",
    "@graphql-tools/schema": "^10.1.0",
    "@octokit/rest": "^22.0.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/exporter-jaeger": "^2.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/instrumentation-ioredis": "^0.69.0",
    "@opentelemetry/resources": "^2.9.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/sdk-trace-base": "^2.9.0",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/mjml": "^5.0.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.81.3",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.1.0",
    "form-data": "^4.0.6",
    "graphql": "^16.14.2",
    "graphql-type-json": "^0.3.2",
    "helmet": "^8.3.0",
    "i18next": "^26.3.6",
    "i18next-http-middleware": "^3.9.8",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "mailgun.js": "^14.0.0",
    "mjml": "^5.4.0",
    "node-cron": "^4.6.0",
    "node-mailjet": "^6.0.6",
    "nodemailer": "^9.0.5",
    "postgres": "^3.4.9",
    "prom-client": "^15.1.0",
    "slugify": "^1.6.9",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^14.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^26.2.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unused-imports": "^4.2.0",
    "otplib": "^13.4.1",
    "pino-pretty": "^13.1.2",
    "supertest": "^7.0.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
