{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@grantjs/*": ["./packages/@grantjs/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  // This list is load-bearing for lint memory, not just for builds. Package tsconfigs
  // exclude **/*.test.ts while their lint scripts still lint all of src, so those test
  // files belong to no package project and typescript-eslint's projectService falls back
  // to this one. Anything matched here is pulled into that fallback program: cdk.out
  // alone is 110k+ .ts files after a few `cdk synth` runs, which takes `pnpm run lint`
  // from 14s/2GB to an out-of-memory crash at 13GB. CI never sees it -- cdk.out is
  // gitignored and the Lint step runs before synth:check -- so this only breaks locally.
  "exclude": [
    "node_modules",
    "dist",
    "build",
    ".next",
    // CDK synth output; regenerated by `cdk synth`/`cdk deploy`, never hand-written.
    "cdk.out",
    "**/cdk.out",
    // Per-story git worktrees (docs/contributing/agentic-sdlc.md) are full repo copies.
    ".worktrees"
  ]
}
