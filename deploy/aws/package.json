{
  "name": "grant-aws-deploy",
  "version": "1.0.0",
  "private": true,
  "description": "CDK construct library and reference app for Grant's AWS serverless deployment target",
  "type": "module",
  "scripts": {
    "lint": "eslint lib bin --ext .ts",
    "lint:fix": "eslint lib bin --ext .ts --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "synth": "node scripts/snapshot-template.mjs",
    "synth:check": "node scripts/snapshot-template.mjs --check",
    "bootstrap": "cdk bootstrap --bootstrap-kms-key-id AWS_MANAGED_KEY -c appUrl=https://bootstrap.invalid -c zoneName=bootstrap.invalid -c hostedZoneId=ZBOOTSTRAPONLY0",
    "put-secrets": "tsx scripts/put-secrets.ts",
    "migrate": "tsx scripts/migrate.ts",
    "smoke": "tsx scripts/smoke.ts"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "aws-cdk": "^2.1140.0",
    "tsx": "^4.23.13",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.11"
  },
  "license": "MIT",
  "dependencies": {
    "aws-cdk-lib": "^2.268.0",
    "constructs": "^10.5.0"
  }
}
