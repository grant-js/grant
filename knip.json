{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "apps/api": {
      "entry": ["src/jobs/**/*.job.ts", "tests/**/*.test.ts"],
      "project": ["src/**/*.ts"],
      // pino-pretty is never imported: @grantjs/logger names it as a string transport
      // target (`target: 'pino-pretty'`), which knip cannot follow. Removing it breaks
      // pretty dev logging at runtime with no build or type error.
      "ignoreDependencies": ["pino-pretty"]
    },
    "apps/web": {
      "entry": ["app/**/*.{ts,tsx}", "middleware.ts"],
      "project": ["**/*.{ts,tsx}"],
      // shadcn/ui generates a component's full API (e.g. AlertDialogPortal, SheetFooter,
      // SidebarMenuBadge) so consumers can compose freely; unused parts are normal for a
      // primitive library. See docs/contributing/code-quality/web.md § Tier 4.
      "ignoreIssues": { "components/ui/**": ["exports", "types"] },
      "ignoreDependencies": [
        // Imported via `@import 'tw-animate-css'` in app/globals.css; knip's config hints
        // confirm .css imports aren't followed for this project. Removing it breaks the build.
        "tw-animate-css",
        // Declared here for workspace-local tooling/IDE resolution but only consumed by the
        // root eslint.config.mjs, which declares the same 4 packages itself — duplicate
        // declarations, not phantom ones.
        "@eslint/eslintrc",
        "@eslint/js",
        "eslint-plugin-react-hooks",
        "typescript-eslint"
      ]
    },
    "packages/@grantjs/*": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    // Same blind spot pass 1 recorded for apps/api, at its source: pino-pretty is
    // never imported, it is named as a pino string transport target here
    // (`target: 'pino-pretty'`, src/index.ts:26), which knip cannot follow. Removing
    // it breaks pretty dev logging at runtime with no build or type error.
    "packages/@grantjs/logger": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["pino-pretty"]
    },
    // knip infers this entry from package.json `main`, so restating it is redundant
    // (knip's own config hint). Declared explicitly anyway to record the blind spot
    // it creates: with src/index.ts as the entry, every re-export from a library
    // package counts as "used", so knip reports no unused exports here by
    // construction. Dead surface in this package has to be measured by
    // cross-referencing consumers — see docs/contributing/code-quality/schema.md.
    "packages/@grantjs/schema": {
      // Tests and their support module are entry points, not dead files: vitest
      // discovers them by glob, which knip cannot follow.
      // knip infers src/index.ts from package.json `main`; naming it again is a
      // redundant-entry hint. Tests and their support module it cannot infer —
      // vitest discovers them by glob.
      "entry": ["src/**/*.test.ts", "src/test-support/**/*.ts"],
      "project": ["src/**/*.ts"]
    },
    // `grant start` opens the browser for the CLI OAuth callback by spawning the
    // platform's opener. xdg-open is resolved from PATH at runtime on Linux, never
    // imported, so knip cannot see it is intentional -- same class as pino-pretty
    // above. It is not a dependency: it ships with the desktop environment.
    "packages/@grantjs/cli": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"],
      "ignoreBinaries": ["xdg-open"]
    },
    "packages/@grantjs/database": {
      // Tests and their support module are entry points, not dead files: vitest
      // discovers them by glob, which knip cannot follow.
      "entry": ["src/index.ts", "src/**/*.test.ts", "src/test-support/**/*.ts"],
      "project": ["src/**/*.ts"]
    }
  },
  "ignore": ["**/generated/**", "**/dist/**", "docs/**"],
  "ignoreDependencies": ["@types/*"],
  // `duplicates` finds one value exported under two names. Both names are in use
  // in the two remaining cases, so resolving them is a rename, not a deletion —
  // tracked in CONCEPTS.md § "One schema, two exported names". Re-enable when settled.
  "exclude": ["duplicates"]
}
